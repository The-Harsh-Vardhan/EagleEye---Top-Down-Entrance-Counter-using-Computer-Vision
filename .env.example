# =============================================================================
# EagleEye Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment.
# Do NOT commit .env to version control!

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
EAGLEEYE_LOG_LEVEL=INFO

# Enable file logging (true/false)
EAGLEEYE_LOG_TO_FILE=true

# -----------------------------------------------------------------------------
# Detection Settings
# -----------------------------------------------------------------------------
# YOLOv8 model: yolov8n.pt (fast), yolov8s.pt (balanced), yolov8m.pt (accurate)
EAGLEEYE_YOLO_MODEL=yolov8n.pt

# Detection confidence threshold (0.0 - 1.0)
EAGLEEYE_CONFIDENCE=0.5

# Minimum detection size in pixels
EAGLEEYE_MIN_SIZE=30

# -----------------------------------------------------------------------------
# Database Settings
# -----------------------------------------------------------------------------
# SQLite database path (relative to project root)
EAGLEEYE_DATABASE_PATH=eagle_eye.db

# -----------------------------------------------------------------------------
# Video Processing Settings
# -----------------------------------------------------------------------------
# Processing width (smaller = faster, None = original resolution)
EAGLEEYE_PROCESSING_WIDTH=960

# Frame skip (process every Nth frame, 1 = all frames)
EAGLEEYE_FRAME_SKIP=3

# Default line position (0.0 = top, 1.0 = bottom)
EAGLEEYE_LINE_POSITION=0.5

# -----------------------------------------------------------------------------
# Dashboard Settings
# -----------------------------------------------------------------------------
# Streamlit server port
STREAMLIT_SERVER_PORT=8501
